{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis.local/terminology-contracts/v1/global_validator_input.schema.json",
  "title": "Global Validator Input Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "candidate_key",
    "input_contract_sha256",
    "context_evidence",
    "attestation_evidence",
    "optional_probes",
    "integrity"
  ],
  "properties": {
    "schema_id": {
      "const": "GlobalValidatorInputV1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate_key": {
      "$ref": "common_defs.schema.json#/$defs/candidateKey"
    },
    "input_contract_sha256": {
      "$ref": "common_defs.schema.json#/$defs/sha256"
    },
    "context_evidence": {
      "$ref": "context_evidence_package.schema.json"
    },
    "attestation_evidence": {
      "$ref": "attestation_evidence_package.schema.json"
    },
    "optional_probes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "optional_probe_package.schema.json"
      }
    },
    "integrity": {
      "$ref": "common_defs.schema.json#/$defs/integrity"
    }
  }
}
