      "model_part_of_speech",
      "model_part_of_speech_confidence",
      "definition_evidence_context_ids",
      "part_of_speech_evidence_context_ids",
      "source_record_sha256"
    ],
    "signature_fields": [
      "definition_status",
      "effective_definition_en",
      "part_of_speech_status",
      "effective_part_of_speech",
      "scope_note"
    ],
    "optional_signature_fields": [
      "effective_definition_en",
      "effective_part_of_speech",
      "scope_note"
    ],
    "definition_status_labels": [
      "ACCEPTED",
      "CORRECTED",
      "REJECTED"
    ],
    "part_of_speech_status_labels": [
      "ACCEPTED",
      "CORRECTED",
      "UNCERTAIN",
      "REJECTED"
    ]
  },
  "group_ranking_policy": "RANK_INDEPENDENT_NON_REJECTED_ONLY",
  "threshold_calibration_allowed": false,
  "contract_sha256": "2867e16fa6dba2e698f62227239fe57f04101f95879e8ecf4ba5bc7f534ef1f7"
}
