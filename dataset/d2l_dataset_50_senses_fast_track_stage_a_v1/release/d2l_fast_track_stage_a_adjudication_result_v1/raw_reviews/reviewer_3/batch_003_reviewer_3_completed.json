            "context_id": "ctx_ba4bc22bf919f20441dc05b2",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "continuous bag of words",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_33f4778e37d3d9c131a2b938",
            "source_text": "![The continuous bag of words model considers the conditional probability of generating the center word given its surrounding context words.](../img/cbow.svg)\n:eqlabel:`fig_cbow`",
            "synthetic": false
