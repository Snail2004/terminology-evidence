            "sentence_id": "sentence_677a13b6f66d36d6302a385a",
            "source_text": "### Input Gate, Forget Gate, and Output Gate",
            "synthetic": false
          },
          {
            "block_id": "d2l_recurrent_modern_lstm_b020",
            "boundary_only": false,
            "chapter_id": "d2l_recurrent_modern",
            "content_sha256": "5dca5c30d09667c90ed8c7f0378328b9f18139891b58d13735d880f3e42c7028",
