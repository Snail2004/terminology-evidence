            "context_id": "ctx_8ee021478cb4ccd5631a27d8",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "classification problems",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_6c28be2f1495a5a81e29e1f3",
            "source_text": "Sigmoids are still widely used as\nactivation functions on the output units,\nwhen we want to interpret the outputs as probabilities\nfor binary classification problems\n(you can think of the sigmoid as a special case of the softmax).",
            "synthetic": false
          },
          {
            "block_id": "d2l_linear_networks_softmax_regression_b067",
            "boundary_only": false,
            "chapter_id": "d2l_linear_networks",
            "content_sha256": "ddf928230de5b25b8b1d49c063972963fac6794d1ad2221c99f7fac845cbb231",
            "context_id": "ctx_96aeca71763647a9e736af8b",
            "evidence_roles": [
              "BACKUP",
              "POSITIVE_POS_PROPOSAL"
            ],
            "matched_surface": "classification problems",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_821a9094fd78e32dd5c7798a",
            "source_text": "* Softmax regression applies to classification problems.",
            "synthetic": false
          },
          {
            "block_id": "d2l_linear_networks_softmax_regression_b051",
            "boundary_only": false,
            "chapter_id": "d2l_linear_networks",
            "content_sha256": "a2738509890c9829faaf4928d07b26a01578aec53ba57a132e7dbd07f788f378",
            "context_id": "ctx_f94fc680303cbcb3c27ab99b",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "classification problems",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_57c332d1cc85d89ebc27a2c9",
            "source_text": "This loss is called the *cross-entropy loss* and it is\none of the most commonly used losses for classification problems.",
            "synthetic": false
          },
          {
            "block_id": "d2l_linear_networks_linear_regression_b003",
            "boundary_only": false,
            "chapter_id": "d2l_linear_networks",
            "content_sha256": "bf5c1cef797a2500017c78d35b59b6a836ec6ae2ac79730fb025a3eb0d11456a",
            "context_id": "ctx_ffdf1a13224ab9169c7fc415",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "classification problems",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_fa2fdf8e96a70f2837b6a7ff",
            "source_text": "In subsequent sections, we will introduce classification problems,\nwhere the goal is to predict membership among a set of categories.",
            "synthetic": false
          },
