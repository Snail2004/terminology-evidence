        "evidence_contexts": [
          {
            "block_id": "d2l_recurrent_modern_gru_b009",
            "boundary_only": false,
            "chapter_id": "d2l_recurrent_modern",
            "content_sha256": "50bb1e197d6c29be52b9b34e8abc9903229c980ea2f6683274c54971784ca96c",
            "context_id": "ctx_12cee07dbdee67f6be90da20",
            "evidence_roles": [
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_5124ba81bbc32751cf3a0de2",
            "source_text": "The outputs of two gates\nare given by two fully-connected layers\nwith a sigmoid activation function.",
            "synthetic": false
          },
          {
            "block_id": "d2l_optimization_optimization_intro_b032",
            "boundary_only": false,
            "chapter_id": "d2l_optimization",
            "content_sha256": "bedb7ac93126a46481a1883474fb22df462ca37cf0912f06ae404adb4b1fecb9",
            "context_id": "ctx_2970e39beda737feef2164c9",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_453ed9cc1b53ac8cf9033180",
            "source_text": "This turns out to be one of the reasons that training deep learning models was quite tricky prior to the introduction of the ReLU activation function.",
            "synthetic": false
          },
          {
            "block_id": "d2l_attention_mechanisms_attention_scoring_functions_b029",
            "boundary_only": false,
            "chapter_id": "d2l_attention_mechanisms",
            "content_sha256": "6a0479c20bf8dd7292a1cc2fea217d7236f9de5517bd380de68697938f9a6247",
            "context_id": "ctx_34ee6d32a2ff535ee2d88bde",
            "evidence_roles": [
              "PRIMARY"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_e6d40ff587d45d8b3e2770ce",
            "source_text": "By using $\\tanh$ as the activation function and disabling\nbias terms,\nwe implement additive attention in the following.",
            "synthetic": false
          },
          {
            "block_id": "d2l_multilayer_perceptrons_mlp_b020",
            "boundary_only": false,
            "chapter_id": "d2l_multilayer_perceptrons",
            "content_sha256": "a5aa30e997f544e69a33ba45007e06200bba28b855378df009a3e4bd3cf1459d",
            "context_id": "ctx_42efd998d80ced9a64e32ec8",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_c446c648e27e3e5c58a44827",
            "source_text": "In order to realize the potential of multilayer architectures,\nwe need one more key ingredient: a\nnonlinear *activation function* $\\sigma$\nto be applied to each hidden unit\nfollowing the affine transformation.",
            "synthetic": false
          },
          {
            "block_id": "d2l_deep_learning_computation_model_construction_b008",
            "boundary_only": false,
            "chapter_id": "d2l_deep_learning_computation",
            "content_sha256": "e559d83b6b5b16033cec0089c5cad3ff2b28a8be8e87386e84433fe4a0bcd026",
            "context_id": "ctx_5f040cdbc06a01d2f5cc4d87",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_9cf7b7c1c3e52e572c5a7378",
            "source_text": "The following code generates a network\nwith one fully-connected hidden layer\nwith 256 units and ReLU activation,\nfollowed by a fully-connected output layer\nwith 10 units (no activation function).",
            "synthetic": false
          },
          {
            "block_id": "d2l_convolutional_modern_alexnet_b004",
            "boundary_only": false,
            "chapter_id": "d2l_convolutional_modern",
            "content_sha256": "0ca57566f563a7b2db146390b6bf7a5d5176479ef194f616ebdc1df53b17ab09",
            "context_id": "ctx_6882a07f8f604f30a2c75617",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "activation functions",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_50967f5935e5922459e028f7",
            "source_text": "Added to these obstacles, key tricks for training neural networks\nincluding parameter initialization heuristics,\nclever variants of stochastic gradient descent,\nnon-squashing activation functions,\nand effective regularization techniques were still missing.",
            "synthetic": false
          },
          {
            "block_id": "d2l_convolutional_neural_networks_why_conv_b042",
            "boundary_only": false,
            "chapter_id": "d2l_convolutional_neural_networks",
            "content_sha256": "569ffdf2213ae1c8226d0b738e79fb4225a75dfc9ef4845a6150ca202ec7f1d4",
            "context_id": "ctx_6ba311f80c075eceefec2cba",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "activation functions",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_db0493e3a64b2c51cd59409b",
            "source_text": "We also need to decide how to compute things efficiently,\nhow to combine multiple layers,\nappropriate activation functions,\nand how to make reasonable design choices\nto yield networks that are effective in practice.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recurrent_neural_networks_rnn_b010",
            "boundary_only": false,
            "chapter_id": "d2l_recurrent_neural_networks",
            "content_sha256": "4a907ea76623f8587abe1296434d29b76af187ff183eded9d106a652ec5f1aa4",
            "context_id": "ctx_733d98a23bc0d5e7b59bd272",
            "evidence_roles": [
              "BACKUP",
              "POSITIVE_DEFINITION_PROPOSAL"
            ],
            "matched_surface": "activation function",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_c41636447d2a3117402f6335",
            "source_text": "Let the hidden layer's activation function be $\\phi$.",
            "synthetic": false
          },
          {
            "block_id": null,
            "boundary_only": true,
            "chapter_id": null,
            "content_sha256": "59530524a93c88db858c4e5f0e7fab037f9fbd5f3dec66267a4782a8b37c7efb",
