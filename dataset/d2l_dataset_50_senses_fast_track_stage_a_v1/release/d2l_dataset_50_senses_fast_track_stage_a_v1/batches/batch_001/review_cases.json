        "matched_surface": "affine transformation",
        "positive_evidence_eligible": true,
        "sentence_id": "sentence_99c102e2d13805c151b8653b",
        "source_text": "If our labels truly were related\nto our input data by an affine transformation,\nthen this approach would be sufficient.",
