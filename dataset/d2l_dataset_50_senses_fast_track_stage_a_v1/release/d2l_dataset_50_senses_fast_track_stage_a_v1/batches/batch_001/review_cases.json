        "matched_surface": "affine transformation",
        "positive_evidence_eligible": true,
        "sentence_id": "sentence_48cffd99a05596627d6fb189",
        "source_text": "This model mapped our inputs directly to our outputs\nvia a single affine transformation,\nfollowed by a softmax operation.",
