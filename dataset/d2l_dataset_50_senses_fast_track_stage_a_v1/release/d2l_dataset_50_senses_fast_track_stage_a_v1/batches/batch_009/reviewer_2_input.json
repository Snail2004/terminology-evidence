            "matched_surface": "train",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_dcc3b2b727703dc039a91106",
            "source_text": "Dump the resulting representations into your favorite classifier, likely a linear model or kernel method, to train a classifier.",
