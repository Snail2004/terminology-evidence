            ],
            "matched_surface": "classification task",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_7568b99807a9271e2595d3c6",
            "source_text": "To help understand the relationship between two text sequences,\nBERT considers a binary classification task, *next sentence prediction*, in its pretraining.",
