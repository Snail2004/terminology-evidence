              "BACKUP"
            ],
            "matched_surface": "classification task",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_6533f50394e6f29e718035af",
            "source_text": "According to descriptions of :numref:`subsec_nsp`,\nthe `_get_next_sentence` function generates a training example\nfor the binary classification task.",
