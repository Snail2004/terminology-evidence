            ],
            "matched_surface": "convolution kernels",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_a764ac4f7da44309f3a540f9",
            "source_text": "One focus of the paper was to address the question\nof which sized convolution kernels are best.",
            "synthetic": false
