            ],
            "matched_surface": "dimensionality",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_54987552a27678ba22c968af",
            "source_text": "Let us [**check whether the outputs have the correct shapes**], e.g., to ensure that the dimensionality of the hidden state remains unchanged.",
            "synthetic": false
          },
          {
            "block_id": null,
            "boundary_only": true,
            "chapter_id": null,
