            ],
            "matched_surface": "multiple channels",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_5cd498b77e4773058cec9c99",
            "source_text": "To support multiple channels in both inputs ($\\mathsf{X}$) and hidden representations ($\\mathsf{H}$),\nwe can add a fourth coordinate to $\\mathsf{V}$: $[\\mathsf{V}]_{a, b, c, d}$.",
            "synthetic": false
          },
          {
            "block_id": "d2l_convolutional_neural_networks_channels_b005",
            "boundary_only": false,
            "chapter_id": "d2l_convolutional_neural_networks",
            "content_sha256": "97fec598084a82fd7a88d3787a0c5f096effd73ab989ac9efb3766e6b1f30c85",
            "context_id": "ctx_3972c87ed9f0cc305dbef415",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "multiple channels",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_d0e3e7a4e3d16a4ce2e845e8",
            "source_text": "When the input data contain multiple channels,\nwe need to construct a convolution kernel\nwith the same number of input channels as the input data,\nso that it can perform cross-correlation with the input data.",
            "synthetic": false
          },
          {
            "block_id": "d2l_natural_language_processing_applications_sentiment_analysis_cnn_b015",
