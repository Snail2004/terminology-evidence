            ],
            "matched_surface": "padding tokens",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_6f04dfec225f4fb387e2b997",
            "source_text": "In the end,\nthe loss for all the tokens\nwill be multipled by the mask to filter out\nirrelevant predictions of padding tokens in the loss.",
            "synthetic": false
