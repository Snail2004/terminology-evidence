            "boundary_only": false,
            "chapter_id": "d2l_convolutional_modern",
            "content_sha256": "051fc2352c6bdaa9c43a3c71d53e5c07043762f6a6f3736c77e375b2ec3f3a75",
            "context_id": "ctx_83aa1ec70a5aa698b67dadb3",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_65ea567aa0b1dda573785112",
            "source_text": "Second, AlexNet used the ReLU instead of the sigmoid\nas its activation function.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recurrent_modern_gru_b009",
            "boundary_only": false,
            "chapter_id": "d2l_recurrent_modern",
            "content_sha256": "50bb1e197d6c29be52b9b34e8abc9903229c980ea2f6683274c54971784ca96c",
            "context_id": "ctx_b1671787eb98927f1ad13a78",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_5124ba81bbc32751cf3a0de2",
            "source_text": "The outputs of two gates\nare given by two fully-connected layers\nwith a sigmoid activation function.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_autorec_b015",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
