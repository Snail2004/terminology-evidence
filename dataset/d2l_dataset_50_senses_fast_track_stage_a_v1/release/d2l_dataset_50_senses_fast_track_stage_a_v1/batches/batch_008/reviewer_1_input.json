            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_9910a4f411497b56c56be39e",
            "source_text": "The basic units in each convolutional block\nare a convolutional layer, a sigmoid activation function,\nand a subsequent average pooling operation.",
            "synthetic": false
          },
          {
            "block_id": "d2l_optimization_lr_scheduler_b006",
