              "BACKUP"
            ],
            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_13449a1fb4388af2142a3f0b",
            "source_text": "For that we pick a slightly modernized version of LeNet (`relu` instead of `sigmoid` activation, MaxPooling rather than AveragePooling), as applied to Fashion-MNIST.",
            "synthetic": false
          },
          {
            "block_id": "d2l_natural_language_processing_pretraining_approx_training_b008",
