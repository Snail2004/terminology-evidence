            "matched_surface": "zero mean",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_660ab0b25fc326a37acc218c",
            "source_text": "We choose our label to be a linear function of our inputs,\ncorrupted by Gaussian noise with zero mean and standard deviation 0.01.",
