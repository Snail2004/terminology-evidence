              "PRIMARY"
            ],
            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_9172893ff95325523c1bdbe4",
            "source_text": "where $\\sigma$ uses the definition of the sigmoid activation function:",
