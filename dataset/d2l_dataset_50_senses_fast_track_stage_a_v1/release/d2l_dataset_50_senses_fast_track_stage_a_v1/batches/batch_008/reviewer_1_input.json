            "positive_evidence_eligible": true,
            "sentence_id": "sentence_ccbb37929b60e42122c64aef",
            "source_text": "Once the valid length is given,\nthe mask corresponding to any padding token\nwill be cleared to zero.",
            "synthetic": false
          },
          {
