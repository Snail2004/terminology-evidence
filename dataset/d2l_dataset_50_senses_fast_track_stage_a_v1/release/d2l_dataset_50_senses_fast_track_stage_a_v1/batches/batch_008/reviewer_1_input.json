            "context_id": "ctx_408899a3fd525147fbd6f4e6",
            "evidence_roles": [
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "skip-gram model",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_167c0020d44529157d2f68ea",
            "source_text": "## The Skip-Gram Model\n:label:`subsec_skip-gram`",
            "synthetic": false
          },
          {
            "block_id": "d2l_natural_language_processing_pretraining_word2vec_b030",
            "boundary_only": false,
            "chapter_id": "d2l_natural_language_processing_pretraining",
