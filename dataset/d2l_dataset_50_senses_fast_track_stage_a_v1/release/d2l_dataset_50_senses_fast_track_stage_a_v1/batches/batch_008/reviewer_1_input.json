            "context_id": "ctx_cf0365ae6ea1bcdfd1296ed3",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "sigmoid",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_08d0a03fa0865e47718bd2d0",
            "source_text": "The activation of encoder is set to `sigmoid` by default and no activation is applied for decoder.",
            "synthetic": false
          },
          {
