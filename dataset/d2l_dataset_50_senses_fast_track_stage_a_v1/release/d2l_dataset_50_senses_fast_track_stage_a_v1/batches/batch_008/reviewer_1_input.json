              "PRIMARY"
            ],
            "matched_surface": "padding tokens",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_bdf696f2cae2434c7ac74462",
            "source_text": "For example,\nif the valid length of two sequences\nexcluding padding tokens\nare one and two, respectively,\nthe remaining entries after\nthe first one\nand the first two entries are cleared to zeros.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recurrent_modern_seq2seq_b055",
