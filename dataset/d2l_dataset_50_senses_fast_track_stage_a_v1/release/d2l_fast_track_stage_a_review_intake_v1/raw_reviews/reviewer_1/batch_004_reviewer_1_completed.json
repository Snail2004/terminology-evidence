            "context_id": "ctx_631db6dfad58f0e98ac2eeaa",
            "evidence_roles": [
              "PRIMARY"
            ],
            "matched_surface": "discrete random variables",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_800985335d6a150119b3b5df",
            "source_text": "Specifically, if $(X, Y)$ is a pair of discrete random variables, then",
            "synthetic": false
          },
          {
            "block_id": "d2l_appendix_mathematics_for_deep_learning_random_variables_b106",
            "boundary_only": false,
            "chapter_id": "d2l_appendix_mathematics_for_deep_learning",
            "content_sha256": "1c82b5fe1f5c1430b27d167549307454a1a6a87583d4a661202637748b7e5fc0",
            "context_id": "ctx_b4043b79b40224019aa27e38",
            "evidence_roles": [
              "PRIMARY"
            ],
            "matched_surface": "discrete random variables",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_0d24772a876b5cf0884f867d",
            "source_text": "This has all been in terms of discrete random variables, but the case of continuous random variables is similar.",
            "synthetic": false
          },
          {
            "block_id": "d2l_appendix_mathematics_for_deep_learning_random_variables_b208",
