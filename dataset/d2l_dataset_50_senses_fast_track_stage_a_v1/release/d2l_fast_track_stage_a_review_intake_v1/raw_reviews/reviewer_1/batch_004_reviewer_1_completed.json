              "BACKUP"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_f0fc1efad5facb51fbe0ec38",
            "source_text": "Clearly, the interaction matrix is extremely sparse (i.e., sparsity = 93.695%).",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_movielens_b012",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "76af98ff580f69bb69203345c4426477a03bf62a51172779c2080e6a769c8740",
            "context_id": "ctx_5565f012ff929a17a39b50a3",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_a3acec6fc3dc2ed25d0b8936",
            "source_text": "We can construct an interaction matrix of size $n \\times m$, where $n$ and $m$ are the number of users and the number of items respectively.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_mf_b004",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "0877a70a59bf5c6deee7957fa9043e8d97126a0342f7da23ea9fe81c4328f309",
            "context_id": "ctx_5614646f2d0d26ef6a76ee86",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_201b1c167e151958262d3a68",
            "source_text": "Specifically, the model factorizes the user-item interaction matrix (e.g., rating matrix) into the product of two lower-rank matrices, capturing the low-rank structure of the user-item interactions.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_movielens_b012",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "0ddc67192da2c08dfeff82bc3d143cb3c505efc2f71626e7a3c9ba603918c097",
            "context_id": "ctx_7288cb7b7bb4df7b76d25aeb",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_be203218a9617e3d75b24bd0",
            "source_text": "This dataset only records the existing ratings, so we can also call it rating matrix and we will use interaction matrix and rating matrix interchangeably in case that the values of this matrix represent exact ratings.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_mf_b002",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "84fdbf3b063a7730bb10a5ea17d9830e3fe1b35707d6020f0445362de2188f9f",
            "context_id": "ctx_8d54eee9a00c6d0088c74e34",
            "evidence_roles": [
              "PRIMARY"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_c8e70647bde1c006e21f6d74",
            "source_text": "The first version of matrix factorization model is proposed by Simon Funk in a famous [blog\npost](https://sifter.org/~simon/journal/20061211.html) in which he described the idea of factorizing the interaction matrix.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_autorec_b003",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "14f8ab568d922064c8d3e237e01bf92c9e409bb6e1de3f883e2d42f959e1579e",
            "context_id": "ctx_a8d97fb4a07460b132bbdf0d",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_7f300d1775a086ff94da7876",
            "source_text": "In AutoRec, instead of explicitly embedding users/items into low-dimensional space, it uses the column/row of the interaction matrix as the input, then reconstructs the interaction matrix in the output layer.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_mf_b005",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "126e1cd06f40a37afe081fe465593def2ce7ffaf130d49c25a0218f7207973a3",
            "context_id": "ctx_b138719571716898b8d88624",
            "evidence_roles": [
              "POSITIVE_DEFINITION_PROPOSAL",
              "POSITIVE_POS_PROPOSAL",
              "PRIMARY"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_8fa4b60dd00b5279b63ddc16",
            "source_text": "Let $\\mathbf{R} \\in \\mathbb{R}^{m \\times n}$ denote the interaction matrix with $m$ users and $n$ items, and the values of $\\mathbf{R}$ represent explicit ratings.",
            "synthetic": false
          },
          {
            "block_id": "d2l_recommender_systems_autorec_b004",
            "boundary_only": false,
            "chapter_id": "d2l_recommender_systems",
            "content_sha256": "3d9a467db5f80d78a9e0c35640b0854c87a9581ac1fb98caecce8884301a92ab",
            "context_id": "ctx_e1b68dcd92df41c824d6b973",
            "evidence_roles": [
              "BACKUP"
            ],
            "matched_surface": "interaction matrix",
            "positive_evidence_eligible": true,
            "sentence_id": "sentence_e5cec1953ccbb566c92f2f5a",
            "source_text": "It uses a partially observed interaction matrix as the input, aiming to reconstruct a completed rating matrix.",
            "synthetic": false
          },
          {
            "block_id": null,
            "boundary_only": true,
            "chapter_id": null,
            "content_sha256": "509c5eaddda498e355f651720d620f49d6a5ef90e31b57df511a17ec4cea774e",
