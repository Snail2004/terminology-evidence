_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_904fe63a6a933828195cc132","source_text":"The `one_hot` function transforms such a minibatch into a three-dimensional tensor with the last dimension equals to the vocabulary size (`len(vocab)`).**)\nWe often transpose the input so that we will obtain an\noutput of shape\n(number of time steps, batch size, vocabulary size)."},{"block_id":"d2l_attention_mechanisms_attention_scoring_functions_b046","chapter_id":"d2l_attention_mechanisms","content_sha256":"cb154a436f55cb3d6fbba3527d6411dd33ae1a52be3f743f087b68f99b47aef8","context_id":"ctx_f5d11ac90b12d0ac504bdbf3","context_role":"PRIMARY","context_sha256":"9414dec00fb28009fd1a16955b1dc109562d14557b796b9baeb603e33fa7da08","context_slot":"C5","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_30932a4e9070cc43edd20934","source_text":"of queries)\n    def forward(self, queries, keys, values, valid_lens=None):\n        d = queries.shape[-1]\n        # Set `transpose_b=True` to swap the last two dimensions of `keys`\n        scores = torch.bmm(queries, keys.transpose(1,2)) / math.sqrt(d)\n        self.attention_weights = masked_softmax(scores, valid_lens)\n        return torch.bmm(self.dropout(self.attention_weights), values)\n```"}],"part_of_speech":[{"block_id":"d2l_recurrent_neural_networks_rnn_scratch_b014","chapter_id":"d2l_recurrent_neural_networks","content_sha256":"3c2bc34ac6049f78c8429fdfc151a8cd89bf4553fafc08e0b7a3a55c510d0994","context_id":"ctx_b0979095fea4bcd28cf2ac0f","context_role":"PRIMARY","context_sha256":"83115caf0210e5e61d40a0080c1ec62bca232fdaa7f807a6a071e20419b3c4a1","context_slot":"C4","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_904fe63a6a933828195cc132","source_text":"The `one_hot` function transforms such a minibatch into a three-dimensional tensor with the last dimension equals to the vocabulary size (`len(vocab)`).**)\nWe often transpose the input so that we will obtain an\noutput of shape\n(number of time steps, batch size, vocabulary size)."},{"block_id":"d2l_attention_mechanisms_attention_scoring_functions_b046","chapter_id":"d2l_attention_mechanisms","content_sha256":"cb154a436f55cb3d6fbba3527d6411dd33ae1a52be3f743f087b68f99b47aef8","context_id":"ctx_f5d11ac90b12d0ac504bdbf3","context_role":"PRIMARY","context_sha256":"9414dec00fb28009fd1a16955b1dc109562d14557b796b9baeb603e33fa7da08","context_slot":"C5","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_30932a4e9070cc43edd20934","source_text":"of queries)\n    def forward(self, queries, keys, values, valid_lens=None):\n        d = queries.shape[-1]\n        # Set `transpose_b=True` to swap the last two dimensions of `keys`\n        scores = torch.bmm(queries, keys.transpose(1,2)) / math.sqrt(d)\n        self.attention_weights = masked_softmax(scores, valid_lens)\n        return torch.bmm(self.dropout(self.attention_weights), values)\n```"}],"primary":[{"block_id":"d2l_preliminaries_linear_algebra_b043","chapter_id":"d2l_preliminaries","content_sha256":"7f8469db0704a90d0ea0b60607bebe2c2e7a0af62aee76f6f042f9119d9f5fbb","context_id":"ctx_8b4f9d8a2db0a1027760532e","context_role":"PRIMARY","context_sha256":"76249fbb75c055734cd4b65231381297a3656998ba6986033516249d44e47c72","context_slot":"C1","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_23345862ddbac53a26f53b2e","source_text":"When we exchange a matrix's rows and columns,\nthe result is called the *transpose* of the matrix."},{"block_id":"d2l_notation_index_b008","chapter_id":"d2l_notation","content_sha256":"9dd8f9b830ae81f33b9b41093676f578294ee1239e4c1287ce1613c5dd43738b","context_id":"ctx_ca28cbd449972202e89c8206","context_role":"PRIMARY","context_sha256":"90fee7e56036c2919463c04225f2985ce38a897da67d56c49a3e58c5f38d2fff","context_slot":"C2","context_type_proposal":"C3","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_ccd68dd16a68a1e6a6cf0b7b","source_text":"* $f(\\cdot)$: a function\n* $\\log(\\cdot)$: the natural logarithm (base $e$)\n* $\\log_2(\\cdot)$: logarithm with base $2$\n* $\\exp(\\cdot)$: the exponential function\n* $\\mathbf{1}(\\cdot)$: the indicator function, evaluates to $1$ if the boolean argument is true and $0$ otherwise\n* $\\mathbf{1}_{\\mathcal{X}}(z)$: the set-membership indicator function, evaluates to $1$ if the element $z$ belongs to the set $\\mathcal{X}$ and $0$ otherwise\n* $\\mathbf{(\\cdot)}^\\top$: transpose of a vector or a matrix\n* $\\mathbf{X}^{-1}$: inverse of matrix $\\mathbf{X}$\n* $\\odot$: Hadamard (elementwise) product\n* $[\\cdot, \\cdot]$: concatenation\n* $\\|\\cdot\\|_p$: $L_p$ norm\n* $\\|\\cdot\\|$: $L_2$ norm\n* $\\langle \\mathbf{x}, \\mathbf{y} \\rangle$: dot product of vectors $\\mathbf{x}$ and $\\mathbf{y}$\n* $\\sum$: summation over a collection of elements\n* $\\prod$: product over a collection of elements\n* $\\stackrel{\\mathrm{def}}{=}$: an equality asserted as a definition of the symbol on the left-hand side"},{"block_id":"d2l_computer_vision_object_detection_dataset_b013","chapter_id":"d2l_computer_vision","content_sha256":"5e8af6faca7b7ab8426acb4bf777bd8b629da9cc0fbfb3ceeff52f801d57be20","context_id":"ctx_0f35f327e3ffb1af62c20c1c","context_role":"PRIMARY","context_sha256":"b9d5c5115e6982cddc852350d1eb0f05584e720f3cae90dfac692eea6519423e","context_slot":"C3","context_type_proposal":"C4","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_44285fa39912d8d4ae38b113","source_text":"```{.python .input}\n#@save\nclass BananasDataset(gluon.data.Dataset):\n    \"\"\"A customized dataset to load the banana detection dataset.\"\"\"\n    def __init__(self, is_train):\n        self.features, self.labels = read_data_bananas(is_train)\n        print('read ' + str(len(self.features)) + (f' training examples' if\n              is_train else f' validation examples'))\n\n    def __getitem__(self, idx):\n        return (self.features[idx].astype('float32').transpose(2, 0, 1),\n                self.labels[idx])\n\n    def __len__(self):\n        return len(self.features)\n```"},{"block_id":"d2l_recurrent_neural_networks_rnn_scratch_b014","chapter_id":"d2l_recurrent_neural_networks","content_sha256":"3c2bc34ac6049f78c8429fdfc151a8cd89bf4553fafc08e0b7a3a55c510d0994","context_id":"ctx_b0979095fea4bcd28cf2ac0f","context_role":"PRIMARY","context_sha256":"83115caf0210e5e61d40a0080c1ec62bca232fdaa7f807a6a071e20419b3c4a1","context_slot":"C4","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_904fe63a6a933828195cc132","source_text":"The `one_hot` function transforms such a minibatch into a three-dimensional tensor with the last dimension equals to the vocabulary size (`len(vocab)`).**)\nWe often transpose the input so that we will obtain an\noutput of shape\n(number of time steps, batch size, vocabulary size)."},{"block_id":"d2l_attention_mechanisms_attention_scoring_functions_b046","chapter_id":"d2l_attention_mechanisms","content_sha256":"cb154a436f55cb3d6fbba3527d6411dd33ae1a52be3f743f087b68f99b47aef8","context_id":"ctx_f5d11ac90b12d0ac504bdbf3","context_role":"PRIMARY","context_sha256":"9414dec00fb28009fd1a16955b1dc109562d14557b796b9baeb603e33fa7da08","context_slot":"C5","context_type_proposal":"C1","matched_surface_exact":"transpose","sense_relation":"SAME_SENSE","sentence_id":"sentence_30932a4e9070cc43edd20934","source_text":"of queries)\n    def forward(self, queries, keys, values, valid_lens=None):\n        d = queries.shape[-1]\n        # Set `transpose_b=True` to swap the last two dimensions of `keys`\n        scores = torch.bmm(queries, keys.transpose(1,2)) / math.sqrt(d)\n        self.attention_weights = masked_softmax(scores, valid_lens)\n        return torch.bmm(self.dropout(self.attention_weights), values)\n```"}]},"model_definition_confidence":0.97,"model_definition_en":"To swap the rows and columns of a matrix or corresponding axes of a tensor.","model_part_of_speech":"verb","model_part_of_speech_confidence":0.95,"policy_id":"d2l_cst_ai_stage_a_prereview_v1_2","schema_id":"D2LCSTAIStageAPreReviewCaseV1","scope_id":"d2l_selected_campaign_scope_v1","sense_id":"d2lce_6b1b75f43b72ec9bace62065","source_payload_sha256":"711ceaa09818bcfee9340fc43207067b9bedf5e96746257be1ecc02a45e53352","source_term":"transpose","source_term_sense_sha256":"6ec1dd541f25ed931ee30d29fe7983ba7a9911ebbb12defd7f742bcb37aeb632","split":"test","surfaces":["transpose"],"term_id":"d2lce_6b1b75f43b72ec9bace62065"}
{"case_sha256":"08bb3be1ee4d4ba800a7e1ff702dc7f1da4ac2dfc76465d80b1a78a0357ffc2c","evidence_contexts":{"backup":[{"block_id":"d2l_computer_vision_neural_style_b024","chapter_id":"d2l_computer_vision","content_sha256":"d37cac57ab1e8adc7a824914946507bbc04c3eef8dc876031ec9bd4c98ae8799","context_id":"ctx_5de6c0208178676906d2a0d9","context_role":"BACKUP","context_sha256":"cc15a7de79135b773354038792aaba029c88df70ba3dd7a9bfc0db84489b7264","context_slot":"B1","context_type_proposal":"C1","matched_surface_exact":"VGG network","sense_relation":"SAME_SENSE","sentence_id":"sentence_376767f8a54af7029dc3389c","source_text":"As mentioned in :numref:`sec_vgg`,\nthe VGG network uses 5 convolutional blocks."},{"block_id":"d2l_computer_vision_ssd_b004","chapter_id":"d2l_computer_vision","content_sha256":"3f458218d03b3b652e9f4b9329f09eca7219b2a9af55dcc1a416c7ff44ca9fed","context_id":"ctx_d44b321b97faec6a56ab5c33","context_role":"BACKUP","context_sha256":"308c39edba3760e80e80401060829f4446dc18c3a56a2365e77cfc4a6dfaff70","context_slot":"B2","context_type_proposal":"C2","matched_surface_exact":"VGG network","sense_relation":"SAME_SENSE","sentence_id":"sentence_b38847b2c3a80d322c8553ea","source_text":"For example,\nthe original single-shot multibox detection paper\nadopts a VGG network truncated before the\nclassification layer :cite:`Liu.Anguelov.Erhan.ea.2016`,\nwhile ResNet has also been commonly used."},{"block_id":"d2l_convolutional_modern_index_b003","chapter_id":"d2l_convolutional_modern","content_sha256":"68a7d333ca53cdddfc627f719e3495e07fee44c374e44635e483a833d1e8547b","context_id":"ctx_cb058f206f42d3b06990201c","context_role":"BACKUP","context_sha256":"7c9fe2bb5cbe1d36cdb307dc4842e606265e8136def56fe56c494f115a2e9a85","context_slot":"B3","context_type_proposal":"C2","matched_surface_exact":"VGG network","sense_relation":"SAME_SENSE","sentence_id":"sentence_df7daf6167d7f8876fa764d2","source_text":"These models include AlexNet, the first large-scale network deployed \nto beat conventional computer vision methods on a large-scale vision challenge;\nthe VGG network, which makes use of a number of repeating blocks of elements; the network in network (NiN) which convolves \nwhole neural networks patch-wise over inputs; \nGoogLeNet, which uses networks with parallel concatenations;\nresidual networks (ResNet), which remain the most popular \noff-the-shelf architecture in computer vision;\nand densely connected networks (DenseNet), \nwhich are expensive to compute but have set some recent benchmarks."}],"contrastive":[{"block_id":"","chapter_id":"","content_sha256":"76c1b2cc3306ead6d89a0f08c82054c72dcf12d24c929e66bea68a9ded37d26a","context_id":"ctxx_b0a67e051ec709b51f04bce9","context_role":"CONTRASTIVE","context_sha256":"f755e6f238b239957e849ad3e9d4a427fdf5d80963cfd60bbfacef8ca9c76614","context_slot":"X1","context_type_proposal":"CONTRASTIVE","matched_surface_exact":"VGG network","sense_relation":"CONTRASTIVE","sentence_id":"","source_text":"Synthetic: VGG network sponsored the event as a media company."}],"definition":[{"block_id":"d2l_convolutional_modern_vgg_b012","chapter_id":"d2l_convolutional_modern","content_sha256":"28323f010c0f4cc6fd4f9e739b641d8b7e79ae0dbf30d0e0447f4227d345963a","context_id":"ctx_a33fa21e3115491f18e2796d","context_role":"PRIMARY","context_sha256":"e2f562f350131f2e9158b52ea97f0f6cf3afc75b649492986b319f9e40255b1e","context_slot":"C1","context_type_proposal":"C1","matched_surface_exact":"VGG Network","sense_relation":"SAME_SENSE","sentence_id":"sentence_81629386660a806f1e7eff8e","source_text":"## [**VGG Network**]"},{"block_id":"d2l_convolutional_modern_vgg_b013","chapter_id":"d2l_convolutional_modern","content_sha256":"b7c3e3d22b8609303f834806d2dab1d4f8da9a12d78177570840c1bf92a3511f","context_id":"ctx_ece546a2d6d19914a8d8e91c","context_role":"PRIMARY","context_sha256":"5962c4dbcc6c46891264bdb7af137dd3585eb235d28c91353a7a7ea524c95126","context_slot":"C4","context_type_proposal":"C1","matched_surface_exact":"VGG Network","sens