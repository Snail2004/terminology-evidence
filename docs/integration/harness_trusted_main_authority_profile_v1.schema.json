{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:HarnessTrustedMainAuthorityProfileV1:1.0.0",
  "title": "HarnessTrustedMainAuthorityProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "issuer_id", "authority_id", "run_id", "phase_id", "split_id", "parent_dataset", "protocol", "producer_authorities", "main_run_authority", "final_glossary_decision", "integrity"],
  "properties": {
    "schema_id": {"const": "HarnessTrustedMainAuthorityProfileV1"},
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["ZERO_PROVIDER_TRUST_PROFILE_ACCEPTED", "LIVE_AUTHORITY_APPROVED"]},
    "issuer_id": {"type": "string", "minLength": 1},
