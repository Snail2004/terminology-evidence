{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:HarnessProducerSafeSubsetCohortAuthorityV1:1.0.0",
  "title": "HarnessProducerSafeSubsetCohortAuthorityV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "status", "issuer_id", "authority_id",
    "run_id", "phase_id", "split_id", "selection_policy",
    "parent_payload_authority", "evaluation_authority",
    "evaluation_phase_membership", "evaluation_phase_membership_sha256",
    "evaluation_candidate_set_sha256", "parent_candidate_count",
    "parent_candidate_identity_sha256", "candidate_count", "candidate_ids",
    "candidate_set_sha256", "candidate_record_set_sha256", "candidate_bindings",
    "sense_count", "sense_ids", "sense_set_sha256", "context_count",
    "context_ids", "context_set_sha256", "context_record_set_sha256",
    "context_bindings", "canary_candidate_id",
    "canary_requires_contrastive_context", "publication_status",
    "provider_calls", "network_calls", "final_glossary_decision", "integrity"
  ],
  "properties": {
    "schema_id": {"const": "HarnessProducerSafeSubsetCohortAuthorityV1"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PRODUCER_SAFE_SUBSET_AUTHORITY_ZERO_PROVIDER"},
    "issuer_id": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "selection_policy": {"const": "EVALUATION_EV02_EXACT_PHASE_PROJECTION_V1"},
    "parent_payload_authority": {"$ref": "#/$defs/binding"},
    "evaluation_authority": {"$ref": "#/$defs/evaluationBinding"},
    "evaluation_phase_membership": {"$ref": "#/$defs/phaseMembership"},
    "evaluation_phase_membership_sha256": {"$ref": "#/$defs/sha"},
    "evaluation_candidate_set_sha256": {"$ref": "#/$defs/sha"},
    "parent_candidate_count": {"const": 150},
    "parent_candidate_identity_sha256": {"$ref": "#/$defs/sha"},
    "candidate_count": {"enum": [1, 15]},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_set_sha256": {"$ref": "#/$defs/sha"},
    "candidate_record_set_sha256": {"$ref": "#/$defs/sha"},
    "candidate_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/candidateBinding"}},
    "sense_count": {"type": "integer", "minimum": 1},
    "sense_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sense_set_sha256": {"$ref": "#/$defs/sha"},
    "context_count": {"type": "integer", "minimum": 1},
    "context_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_set_sha256": {"$ref": "#/$defs/sha"},
    "context_record_set_sha256": {"$ref": "#/$defs/sha"},
    "context_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/contextBinding"}},
    "canary_candidate_id": {"type": "string", "minLength": 1},
    "canary_requires_contrastive_context": {"const": true},
    "publication_status": {"const": "FINAL_GIT_PUBLICATION_RECEIPT_ACCEPTED_ZERO_PROVIDER"},
    "provider_calls": {"const": 0},
    "network_calls": {"const": 0},
    "final_glossary_decision": {"type": "null"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["self_sha256"], "properties": {"self_sha256": {"$ref": "#/$defs/sha"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["relative_path", "physical_sha256", "self_sha256"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha"}, "self_sha256": {"$ref": "#/$defs/sha"}}},
    "evaluationBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["child_commit", "parent_commit", "child_tree", "relative_path", "physical_sha256", "cohort_member_path", "cohort_physical_sha256", "cohort_self_sha256", "candidate_set_sha256", "selection_authority_sha256", "selection_policy_id", "canary_candidate_id"],
      "properties": {
        "child_commit": {"$ref": "#/$defs/gitOid"}, "parent_commit": {"$ref": "#/$defs/gitOid"}, "child_tree": {"$ref": "#/$defs/gitOid"},
        "relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha"},
        "cohort_member_path": {"type": "string", "minLength": 1}, "cohort_physical_sha256": {"$ref": "#/$defs/sha"},
        "cohort_self_sha256": {"$ref": "#/$defs/sha"}, "candidate_set_sha256": {"$ref": "#/$defs/sha"},
        "selection_authority_sha256": {"$ref": "#/$defs/sha"}, "selection_policy_id": {"type": "string", "minLength": 1},
        "canary_candidate_id": {"type": "string", "minLength": 1}
      }
    },
    "phaseMembership": {"type": "object", "additionalProperties": false, "required": ["CANARY", "REMAINDER"], "properties": {"CANARY": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "REMAINDER": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "candidateBinding": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_version", "sense_id", "context_ids", "record_sha256"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "candidate_version": {"type": "string", "minLength": 1}, "sense_id": {"type": "string", "minLength": 1}, "context_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "record_sha256": {"$ref": "#/$defs/sha"}}},
    "contextBinding": {"type": "object", "additionalProperties": false, "required": ["context_id", "sense_id", "context_class", "record_sha256"], "properties": {"context_id": {"type": "string", "minLength": 1}, "sense_id": {"type": "string", "minLength": 1}, "context_class": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
