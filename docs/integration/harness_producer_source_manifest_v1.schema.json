{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:HarnessProducerSourceManifestV1:1.0.0",
  "title": "HarnessProducerSourceManifestV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "producer_role", "producer", "candidate_count", "candidate_set_sha256", "producer_release_receipt", "final_glossary_decision", "integrity"],
  "properties": {
    "schema_id": {"const": "HarnessProducerSourceManifestV1"}, "schema_version": {"const": "1.0.0"}, "status": {"const": "COMPLETE"}, "producer_role": {"enum": ["context_evidence", "attestation_evidence"]},
    "producer": {"$ref": "#/$defs/producer"}, "candidate_count": {"type": "integer", "minimum": 1}, "candidate_set_sha256": {"$ref": "#/$defs/sha"},
    "producer_release_receipt": {"$ref": "#/$defs/binding"}, "final_glossary_decision": {"type": "null"}, "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "integrity": {"type": "object", "additionalProperties": false, "required": ["self_sha256"], "properties": {"self_sha256": {"$ref": "#/$defs/sha"}}}, "binding": {"type": "object", "additionalProperties": false, "required": ["relative_path", "physical_sha256", "self_sha256"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha"}, "self_sha256": {"$ref": "#/$defs/sha"}}}, "producer": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_version", "run_id", "commit", "tree"], "properties": {"component_id": {"type": "string", "minLength": 1}, "component_version": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/oid"}, "tree": {"$ref": "#/$defs/oid"}}}}
}
