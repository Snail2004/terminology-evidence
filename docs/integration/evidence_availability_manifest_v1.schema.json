{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:EvidenceAvailabilityManifestV1:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "adapter_mode", "run_id", "phase_id", "split_id", "expected_candidate_count", "expected_roles", "producer_sets", "rows", "counts", "final_glossary_decision", "integrity"],
  "properties": {
    "schema_id": {"const": "EvidenceAvailabilityManifestV1"}, "schema_version": {"const": "1.0.0"},
    "adapter_mode": {"enum": ["OFFICIAL_5_15_PREFLIGHT", "SYNTHETIC_50_150_CONFORMANCE"]},
    "run_id": {"type": "string", "minLength": 1}, "phase_id": {"type": "string", "minLength": 1}, "split_id": {"type": "string", "minLength": 1},
    "expected_candidate_count": {"enum": [15, 150]}, "expected_roles": {"const": ["context_evidence", "attestation_evidence"]},
    "producer_sets": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/producerSet"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "counts": {"$ref": "#/$defs/counts"}, "final_glossary_decision": {"type": "null"}, "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["self_sha256"], "properties": {"self_sha256": {"$ref": "#/$defs/sha256"}}},
    "candidateKey": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_version", "source_term", "candidate_vi", "sense_id", "scope_id", "sense_inventory_version", "dataset_manifest_sha256", "effective_sense_contract_sha256", "input_contract_sha256"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "candidate_version": {"type": "string", "minLength": 1}, "source_term": {"type": "string", "minLength": 1}, "candidate_vi": {"type": "string", "minLength": 1}, "sense_id": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "minLength": 1}, "sense_inventory_version": {"type": "string", "minLength": 1}, "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"}, "effective_sense_contract_sha256": {"$ref": "#/$defs/sha256"}, "input_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "packageProducer": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_version", "run_id"], "properties": {"component_id": {"type": "string", "minLength": 1}, "component_version": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}}},
    "setProducer": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_version", "run_id", "commit"], "properties": {"component_id": {"type": "string", "minLength": 1}, "component_version": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}}},
    "package": {"type": ["object", "null"], "additionalProperties": false, "required": ["relative_path", "physical_sha256", "self_sha256", "producer"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha256"}, "self_sha256": {"$ref": "#/$defs/sha256"}, "producer": {"$ref": "#/$defs/packageProducer"}}},
    "receipt": {"type": ["object", "null"], "additionalProperties": false, "required": ["relative_path", "physical_sha256", "self_sha256"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha256"}, "self_sha256": {"$ref": "#/$defs/sha256"}}},
    "producerSet": {"type": "object", "additionalProperties": false, "required": ["role", "manifest_self_sha256", "manifest_physical_sha256", "producer"], "properties": {"role": {"enum": ["context_evidence", "attestation_evidence"]}, "manifest_self_sha256": {"$ref": "#/$defs/sha256"}, "manifest_physical_sha256": {"$ref": "#/$defs/sha256"}, "producer": {"$ref": "#/$defs/setProducer"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["candidate_key", "role", "status", "observed_at", "reason_code", "validation_error_code", "package", "external_hold_receipt"], "properties": {"candidate_key": {"$ref": "#/$defs/candidateKey"}, "role": {"enum": ["context_evidence", "attestation_evidence"]}, "status": {"enum": ["PRESENT", "EXTERNAL_HOLD", "MISSING", "INVALID"]}, "observed_at": {"type": "string", "minLength": 1}, "reason_code": {"type": ["string", "null"]}, "validation_error_code": {"type": ["string", "null"]}, "package": {"$ref": "#/$defs/package"}, "external_hold_receipt": {"$ref": "#/$defs/receipt"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["PRESENT", "EXTERNAL_HOLD", "MISSING", "INVALID"], "properties": {"PRESENT": {"type": "integer", "minimum": 0}, "EXTERNAL_HOLD": {"type": "integer", "minimum": 0}, "MISSING": {"type": "integer", "minimum": 0}, "INVALID": {"type": "integer", "minimum": 0}}}
  }
}
