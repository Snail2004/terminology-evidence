{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:HarnessCandidateCohortAuthorityV1:1.0.0",
  "title": "HarnessCandidateCohortAuthorityV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "run_id", "phase_id", "split_id", "candidate_count", "candidate_set_sha256", "candidates", "final_glossary_decision", "integrity"],
  "properties": {
    "schema_id": {"const": "HarnessCandidateCohortAuthorityV1"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 1},
    "candidate_set_sha256": {"$ref": "#/$defs/sha"},
    "candidates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/candidateKey"}},
    "final_glossary_decision": {"type": "null"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_version", "source_term", "candidate_vi", "sense_id", "scope_id", "sense_inventory_version", "dataset_manifest_sha256", "effective_sense_contract_sha256", "input_contract_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "minLength": 1},
        "source_term": {"type": "string", "minLength": 1},
        "candidate_vi": {"type": "string", "minLength": 1},
        "sense_id": {"type": "string", "minLength": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "sense_inventory_version": {"type": "string", "minLength": 1},
        "dataset_manifest_sha256": {"$ref": "#/$defs/sha"},
        "effective_sense_contract_sha256": {"$ref": "#/$defs/sha"},
        "input_contract_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "integrity": {"type": "object", "additionalProperties": false, "required": ["self_sha256"], "properties": {"self_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
