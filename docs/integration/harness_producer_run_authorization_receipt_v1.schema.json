{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminology-evidence:HarnessProducerRunAuthorizationReceiptV1:1.0.0",
  "title": "HarnessProducerRunAuthorizationReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "issuer_id", "authority_id", "run_id", "phase_id", "split_id", "candidate_key", "role", "producer", "main_live_authorization_receipt", "final_glossary_decision", "integrity"],
  "properties": {
    "schema_id": {"const": "HarnessProducerRunAuthorizationReceiptV1"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "AUTHORIZED"},
    "issuer_id": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "phase_id": {"type": "string", "minLength": 1},
    "split_id": {"type": "string", "minLength": 1},
    "candidate_key": {"$ref": "#/$defs/candidateKey"},
    "role": {"enum": ["context_evidence", "attestation_evidence"]},
    "producer": {"$ref": "#/$defs/producer"},
    "main_live_authorization_receipt": {"$ref": "#/$defs/binding"},
    "final_glossary_decision": {"type": "null"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateKey": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_version", "source_term", "candidate_vi", "sense_id", "scope_id", "sense_inventory_version", "dataset_manifest_sha256", "effective_sense_contract_sha256", "input_contract_sha256"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "candidate_version": {"type": "string", "minLength": 1}, "source_term": {"type": "string", "minLength": 1}, "candidate_vi": {"type": "string", "minLength": 1}, "sense_id": {"type": "string", "minLength": 1}, "scope_id": {"type": "string", "minLength": 1}, "sense_inventory_version": {"type": "string", "minLength": 1}, "dataset_manifest_sha256": {"$ref": "#/$defs/sha"}, "effective_sense_contract_sha256": {"$ref": "#/$defs/sha"}, "input_contract_sha256": {"$ref": "#/$defs/sha"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["component_id", "component_version", "run_id", "commit", "tree"], "properties": {"component_id": {"type": "string", "minLength": 1}, "component_version": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "commit": {"$ref": "#/$defs/oid"}, "tree": {"$ref": "#/$defs/oid"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["relative_path", "physical_sha256", "self_sha256"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "physical_sha256": {"$ref": "#/$defs/sha"}, "self_sha256": {"$ref": "#/$defs/sha"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["self_sha256"], "properties": {"self_sha256": {"$ref": "#/$defs/sha"}}}
  }
}
